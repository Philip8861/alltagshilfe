# Öffentliche Basis-URL der Website (für Canonical, OG, Sitemap).
# Beim Umzug auf anderen Server nur hier anpassen – keine Änderung im Code nötig.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: Indeed-Stellen-URL (Karriere-Seite)
# NEXT_PUBLIC_INDEED_JOBS_URL=https://de.indeed.com/cmp/Alltagshilfe-Süd/jobs

# Interne Benachrichtigungen (Kontakt, Karriere, Pflegebox) per SMTP — z. B. ALL-INKL:
# Ausgangsserver im KAS: typisch DEIN-KAS-LOGIN.kasserver.com (nicht die Domain als Host — siehe ALL-INKL Hilfe zu SSL/TLS).
# Port 465 + SMTP_SECURE=true (SSL) ODER Port 587 + SMTP_SECURE=false (STARTTLS)
# SMTP_USER = vollständige E-Mail-Adresse des Postfachs; SMTP_PASS = Passwort des Postfachs
# NOTIFICATION_TO = Fallback für alle Kanäle, wenn die spezifische Variable fehlt (kommagetrennt möglich)
# Pro Kanal eigene Ziele (optional; überschreibt den Fallback für diesen Kanal):
# NOTIFICATION_TO_CONTACT=kontakt@ihre-domain.de
# Kontaktformular: Thema „Karriere“ → zuerst NOTIFICATION_TO_CONTACT_TOPIC_KARRIERE, sonst dieselbe Adresse wie Bewerbungsformular (NOTIFICATION_TO_KARRIERE), sonst NOTIFICATION_TO_CONTACT:
# NOTIFICATION_TO_CONTACT_TOPIC_KARRIERE=daniel.niebauer@alltagshilfe-sued.de
# NOTIFICATION_TO_KARRIERE=karriere@ihre-domain.de
# NOTIFICATION_TO_PFLEGEBOX=pflegebox@ihre-domain.de
# SMTP_HOST=w0123456.kasserver.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@ihre-domain.de
# SMTP_PASS=
# NOTIFICATION_TO=info@ihre-domain.de
# Optional: Absenderzeile (sonst: Website <SMTP_USER>)
# MAIL_FROM="Alltagshilfe <noreply@ihre-domain.de>"
# Nur serverseitig, niemals NEXT_PUBLIC_*

# Partnerportal (Supabase, EU-Region empfohlen — siehe supabase/migrations/001_partner_portal.sql)
# Kurzname-Login: ohne @ wird name@<DOMAIN> an Supabase geschickt (Standard partners.invalid).
# NEXT_PUBLIC_PARTNER_AUTH_EMAIL_DOMAIN=partners.invalid
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service Role nur serverseitig (Pflegebox-Abschluss, Partner anlegen in Verwaltung) — niemals NEXT_PUBLIC oder Client
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Partner-Verwaltung (/partner/admin-login → /partner/admin): Zugang NUR aus Env, niemals im Code committen.
# PARTNER_SYSTEM_ADMIN_USER=admin
# PARTNER_SYSTEM_ADMIN_PASSWORD=Ihr-starkes-Passwort
# PARTNER_SYSTEM_ADMIN_SECRET=mindestens-24-zeichen-zufaellig
#
# Monatsabrechnung Partner-Provisionen: GET /api/cron/partner-payout-settle
# In Vercel: CRON_SECRET setzen (Cron sendet Authorization: Bearer …). Optional zusätzlich PARTNER_PAYOUT_CRON_SECRET für manuellen Aufruf per ?secret=
# CRON_SECRET=
# PARTNER_PAYOUT_CRON_SECRET=
