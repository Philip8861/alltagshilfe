# Öffentliche Basis-URL der Website (für Canonical, OG, Sitemap).
# Beim Umzug auf anderen Server nur hier anpassen – keine Änderung im Code nötig.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: Indeed-Stellen-URL (Karriere-Seite)
# NEXT_PUBLIC_INDEED_JOBS_URL=https://de.indeed.com/cmp/Alltagshilfe-Süd/jobs

# Optional: E-Mail-/CRM-Anbindung für Kontaktformular (später)
# CONTACT_EMAIL=
# SMTP_* oder API-Keys nur serverseitig nutzen, nicht NEXT_PUBLIC_*

# Partnerportal (Supabase, EU-Region empfohlen — siehe supabase/migrations/001_partner_portal.sql)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
