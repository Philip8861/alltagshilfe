# === Kopie nach .env.local ===
# 1. Diese Datei nach ".env.local" kopieren (gleicher Ordner wie package.json)
#    PowerShell: Copy-Item .env.local.template .env.local
# 2. Alle leeren Werte unten ausfüllen (Supabase: Settings → API).
# 3. SECRET: npm run partner:admin-secret
# .env.local wird nicht mit Git committed.

# Website (Live-URL oder lokal http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Interne Partner-Verwaltung (/partner/admin-login) — eigene Zugangsdaten wählen
PARTNER_SYSTEM_ADMIN_USER=
PARTNER_SYSTEM_ADMIN_PASSWORD=
PARTNER_SYSTEM_ADMIN_SECRET=
