# === Kopie nach .env.local ===
# 1. Diese Datei nach ".env.local" kopieren (gleicher Ordner wie package.json)
#    PowerShell: Copy-Item .env.local.template .env.local
# 2. Alle leeren Werte unten ausfüllen (Supabase: Settings → API).
# 3. SECRET: npm run partner:admin-secret
# .env.local wird nicht mit Git committed.

# Website (Live-URL oder lokal http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Optional: Domain für Kurznamen-Login (Standard partners.invalid wenn leer)
# NEXT_PUBLIC_PARTNER_AUTH_EMAIL_DOMAIN=partners.invalid

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Anon-Key: entweder JWT (eyJ...) ODER publishable (sb_publishable_...) — immer dieser Variablenname:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Interne Partner-Verwaltung (/partner/admin-login) — eigene Zugangsdaten wählen
PARTNER_SYSTEM_ADMIN_USER=
PARTNER_SYSTEM_ADMIN_PASSWORD=
PARTNER_SYSTEM_ADMIN_SECRET=

# E-Mail-Benachrichtigungen (ALL-INKL SMTP — Host aus KAS, z. B. w0123456.kasserver.com)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# NOTIFICATION_TO=
# NOTIFICATION_TO_CONTACT=
# NOTIFICATION_TO_KARRIERE=
# NOTIFICATION_TO_PFLEGEBOX=
# MAIL_FROM=
